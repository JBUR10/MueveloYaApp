# Copia este archivo a .env y completa tus valores (Supabase > Project Settings > API Keys).
# Solo usa la clave PUBLISHABLE (sb_publishable_...). Nunca pongas la secret/service_role en la app.
EXPO_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
